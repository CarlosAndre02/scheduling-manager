# A commit SHA CI has already published to ECR, used only to seed the parameter
# on the first apply. Changing it later plans nothing: from that point the value
# belongs to scripts/release.sh, and an apply that could move it would be an
# unannounced rollback.
image_tag = "0000000000000000000000000000000000000000"

# Where alarms are delivered. No default: an alarm nobody receives is a resource
# that costs money and reports nothing. AWS emails a confirmation link and the
# subscription stays silent until it is clicked.
alert_email = "you@example.com"

# Thresholds worth correcting once there is a week of real traffic behind them.
#
# error_alarm_count        = 5      # server errors in five minutes
# latency_alarm_ms         = 1000   # p95, held for two periods
# cpu_credit_alarm_balance = 60     # below this, surplus CPU is being billed
# disk_alarm_percent       = 80     # released images accumulate
#
# Silence is only an incident once there is traffic to lose. Zero leaves the
# alarm uncreated; set it to the floor a quiet hour should still clear.
# traffic_alarm_min_requests = 0
# log_retention_days       = 30

# Leave domain_name empty to bring the stack up without a certificate: the
# application answers plain HTTP on the Elastic IP, which is enough to prove the
# machine, the image and the database connection, and is not a state to serve
# real traffic from. See README.md.
#
# domain_name       = "api.example.com"
# acme_email        = "you@example.com"
# route53_zone_name = "example.com"

# Switch to false only once the boot is stable. Staging certificates are not
# trusted by browsers; production allows five duplicate certificates a week.
# acme_staging = true

# Read database_pool_size off the Supabase pooler configuration. It is divided
# across app_replicas to derive each container's DATABASE_POOL_MAX.
#
# project            = "scheduling-manager"
# region             = "us-east-1"
# instance_type      = "t4g.small"
# root_volume_size   = 20
# app_replicas       = 2
# database_pool_size = 15
# rate_limit_average = 20
# rate_limit_burst   = 50
# in_flight_limit    = 20
