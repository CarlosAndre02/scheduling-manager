#!/usr/bin/env bash
#
# The deploy. Reads what should be running from Parameter Store, brings it up,
# and is safe to run again with nothing changed.
#
#   sudo /opt/app/deploy.sh
#
# Remotely, without opening a port or holding a key, and with the checks around
# it that a release needs:
#
#   scripts/release.sh <sha>
#
# Deliberately not `set -x`: the database URL passes through this script.
set -euo pipefail

cd /opt/app

param() {
  aws ssm get-parameter --region "${region}" --name "$1" --with-decryption \
    --query Parameter.Value --output text
}

TAG=$(param "/${project}/image-tag")
REPLICAS=$(param "/${project}/app-replicas")

# The pooler hands out a fixed number of connections and every container claims
# a share of it. Deriving the share here, rather than fixing it at boot, means
# changing the replica count cannot quietly ask for more than the pooler gives.
POOL_MAX=$(( ${database_pool_size} / REPLICAS ))
[ "$POOL_MAX" -lt 1 ] && POOL_MAX=1

# Both files are written before the pull, so a failed pull leaves the previous
# containers running against configuration that still matches them.
umask 077

# Never echoed, never an argument — a command line is readable by every process
# on the host.
printf 'DATABASE_URL=%s\n' "$(param "/${project}/database-url")" > app.env

cat > .env <<ENVFILE
APP_IMAGE=${registry}/${project}:$TAG
APP_REPLICAS=$REPLICAS
DATABASE_POOL_MAX=$POOL_MAX
ENVFILE

# The token lasts twelve hours, so this runs every deploy rather than once.
aws ecr get-login-password --region "${region}" \
  | docker login --username AWS --password-stdin "${registry}"

docker compose pull
docker compose up -d --remove-orphans

# `up -d` returns once the containers exist, which is not the same as the
# application answering. The difference has already shipped a broken release:
# an image built for the wrong architecture is created, dies in milliseconds,
# restarts forever, and every step before this one reports success — the only
# symptom being a bare 404 from a proxy with no backend. The image declares a
# HEALTHCHECK, so the host can tell "started" from "working".
readonly HEALTH_TIMEOUT=120

settled() {
  local waited=0 ids healthy

  while [ "$waited" -lt "$HEALTH_TIMEOUT" ]; do
    ids=$(docker compose ps --quiet app)

    # Unquoted on purpose: one id per replica, and each has to become an
    # argument of its own.
    healthy=$(docker inspect --format '{{.State.Health.Status}}' $ids 2>/dev/null \
      | grep -c '^healthy$' || true)

    [ "$healthy" -ge "$REPLICAS" ] && return 0

    sleep 5
    waited=$(( waited + 5 ))
  done

  return 1
}

# Deliberately not a revert. Rolling back from here would be guessing at a cause
# this script cannot see: a database that is unreachable fails the health check
# of every image equally, and the host would flip between two perfectly good
# releases while the real fault goes unreported. Failing is louder, and the way
# back is one command from a person who knows which one it is.
if ! settled; then
  echo "deploy failed: ${project}:$TAG never reported $REPLICAS healthy containers" >&2
  echo "the previous release is no longer running — roll back with scripts/release.sh" >&2
  docker compose ps >&2
  docker compose logs --tail 50 app >&2
  exit 1
fi

# Only once the release is known good, and only dangling layers: the previous
# release keeps its tag and therefore survives this, which is what makes a
# rollback a pull from the local disk rather than from the registry.
docker image prune --force

echo "deployed ${project}:$TAG with $REPLICAS replicas, pool $POOL_MAX each"
