NODE_ENV=development
SERVER_PORT=4000

# trace | debug | info | warn | error | fatal. Log services bill per GB
# ingested, so a level left below info in production is a recurring bill.
# NODE_ENV=production also switches the output from pretty to JSON.
LOG_LEVEL=info

# Error tracking. Empty disables it entirely, which is the state every local run
# and every test is in — a tracker nobody configured must not be a requirement
# for running the application. In production the DSN is a SecureString in
# Parameter Store and APP_RELEASE is the deployed commit, both written by the
# deploy; see docs/observability-and-monitoring.md.
SENTRY_DSN=
APP_RELEASE=

# Fraction of requests whose Express handlers and database queries are timed.
# Zero collects nothing. Spans are billed by volume, and a percentage answers
# the same question — a slow query is slow in every sample.
SENTRY_TRACES_SAMPLE_RATE=0

TRUSTED_PROXY_HOPS=0

# Comma-separated origins allowed to read responses from a browser. Empty sends
# no CORS header at all, which is what makes a browser refuse the read.
CORS_ORIGINS=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=scheduling_manager
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/scheduling_manager
DATABASE_POOL_MAX=10

# TLS. Never put sslmode in DATABASE_URL: pg lets the connection string replace
# the ssl option wholesale, so an sslmode there discards DATABASE_SSL_CA.
# Local Postgres speaks plaintext, so both stay empty here.
#   DATABASE_SSL_CA  path to the provider's CA bundle — verifies against it
#   DATABASE_SSL     "true" for a provider whose certificate is publicly trusted
DATABASE_SSL_CA=
DATABASE_SSL=

# Cancels a query that overruns, so its connection returns to the pool.
# The migration step must override this with 0 — see docs/api.md.
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Shutdown: no load balancer locally, so there is nothing to drain.
# Behind an ALB, use SHUTDOWN_DRAIN_DELAY_MS=5000 or higher.
SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=15000
