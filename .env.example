NODE_ENV=development
SERVER_PORT=4000

TRUSTED_PROXY_HOPS=0

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=scheduling_manager
POSTGRES_PASSWORD=local_password
DATABASE_URL=postgresql://local_user:local_password@localhost:5432/scheduling_manager
DATABASE_POOL_MAX=10

# Shutdown: no load balancer locally, so there is nothing to drain.
# Behind an ALB, use SHUTDOWN_DRAIN_DELAY_MS=5000 or higher.
SHUTDOWN_DRAIN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=15000
