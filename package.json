{
  "name": "scheduling-manager",
  "version": "1.0.0",
  "description": "A TypeScript scheduling manager application",
  "author": "Carlos André",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "dev": "npm run services:down && npm run services:up && npm run db:migrate && nodemon src/index.ts",
    "test": "concurrently -n server,jest --hide server -k -s command-jest \"npm run dev\" \"wait-on http://localhost:4000/health && jest --runInBand --verbose\"",
    "posttest": "npm run services:stop",
    "test:watch": "jest --watchAll --runInBand --verbose",
    "test:image": "npm run image:build && jest --config jest.image.config.js --runInBand --verbose",
    "image:build": "docker build -t scheduling-manager:test .",
    "services:up": "docker compose -f infra/docker-compose.yaml up -d --wait",
    "services:stop": "docker compose -f infra/docker-compose.yaml stop",
    "services:down": "docker compose -f infra/docker-compose.yaml down",
    "db:migrate": "tsx src/shared/database/migrate.ts",
    "db:migrate:prod": "node dist/shared/database/migrate.js",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:drop": "drizzle-kit drop",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "lint:check": "eslint .",
    "prepare": "husky",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}": "prettier --write"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "wait-on": "^9.1.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
